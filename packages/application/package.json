{
  "name": "@bsd/application",
  "version": "0.0.0",
  "private": true,
  "description": "Command and query services: permission checks, validation, one transaction, idempotency and audit per write (PLAN §3). Server-side only.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "load-cartons": "tsx src/scripts/load-cartons.ts",
    "seed-demo": "node --max-old-space-size=8192 --import tsx src/scripts/seed-demo.ts",
    "zero-staff-balances": "tsx src/scripts/zero-staff-balances.ts",
    "fix-rso-batch-stock": "tsx src/scripts/fix-rso-batch-stock.ts",
    "fix-negative-batch-stock": "tsx src/scripts/fix-negative-batch-stock.ts",
    "wipe-companies": "tsx src/scripts/wipe-companies.ts"
  },
  "dependencies": {
    "@bsd/auth": "workspace:*",
    "@bsd/contracts": "workspace:*",
    "@bsd/database": "workspace:*",
    "@bsd/domain": "workspace:*",
    "@bsd/importer": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "dotenv": "18.0.5",
    "tsx": "4.23.15"
  }
}
