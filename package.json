{
  "name": "bhuiyan-store-distribution-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @bsd/web dev",
    "build": "pnpm --filter @bsd/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:domain": "vitest run packages/domain",
    "verify:workbook": "vitest run --config vitest.workbook.config.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "benchmark:sql": "node scripts/test-integration.mjs --benchmark",
    "db:migrate": "pnpm --filter @bsd/database migrate:deploy",
    "db:bootstrap-admin": "pnpm --filter @bsd/auth bootstrap-admin",
    "check": "pnpm format:check && pnpm lint && pnpm check:types && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
